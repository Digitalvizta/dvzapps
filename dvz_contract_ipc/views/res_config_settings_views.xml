<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dvz_ipc" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dvz_contract_ipc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="dvz_contract.res_config_settings_view_form_dvz_contract"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='dvz_contract_boq']" position="after">
                <block title="Payment certificates (IPC)" name="dvz_contract_ipc">
                    <setting id="dvz_ipc_approval" help="Certificates go to a manager for approval before invoicing.">
                        <field name="dvz_ipc_approval_required"/>
                    </setting>
                    <setting string="Progress entry" help="How site progress is entered on certificates.">
                        <field name="dvz_ipc_entry_mode" widget="radio"/>
                    </setting>
                    <setting string="Invoice layout" help="Summary line per certificate, or one line per BOQ item.">
                        <field name="dvz_ipc_invoice_detail" widget="radio"/>
                    </setting>
                    <setting string="Retention method" help="How retention appears on invoices.">
                        <field name="dvz_retention_method" widget="radio"/>
                    </setting>
                    <setting id="dvz_ipc_overrun" help="Allow cumulative quantities above the BOQ quantity.">
                        <field name="dvz_ipc_allow_overrun"/>
                    </setting>
                    <setting id="dvz_ipc_autopost" help="Post certificate and advance invoices as soon as they are created.">
                        <field name="dvz_ipc_auto_post"/>
                    </setting>
                    <setting id="dvz_ipc_bilingual" help="Print certificate labels in English and Arabic.">
                        <field name="dvz_ipc_bilingual_report"/>
                    </setting>
                </block>
                <block title="Certificate accounting" name="dvz_contract_ipc_accounting">
                    <setting string="Revenue" help="Journal, product and account for work done. Empty account = product income account.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="dvz_ipc_journal_id" class="col-lg-5 o_light_label" string="Journal"/>
                                <field name="dvz_ipc_journal_id" options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="dvz_progress_product_id" class="col-lg-5 o_light_label" string="Product"/>
                                <field name="dvz_progress_product_id" options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="dvz_progress_account_id" class="col-lg-5 o_light_label" string="Account"/>
                                <field name="dvz_progress_account_id" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Deduction accounts" help="Accounts for retention, advance payment and other deductions.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="dvz_retention_account_id" class="col-lg-5 o_light_label" string="Retention"/>
                                <field name="dvz_retention_account_id" options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="dvz_advance_account_id" class="col-lg-5 o_light_label" string="Advance"/>
                                <field name="dvz_advance_account_id" options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="dvz_deduction_account_id" class="col-lg-5 o_light_label" string="Other deductions"/>
                                <field name="dvz_deduction_account_id" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="dvz_adv_tax" help="Tax treatment of the advance invoice and of each recovery.">
                        <field name="dvz_advance_invoice_taxed"/>
                        <div class="mt8">
                            <field name="dvz_advance_recovery_taxed" class="oe_inline"/>
                            <label for="dvz_advance_recovery_taxed" class="o_light_label"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
