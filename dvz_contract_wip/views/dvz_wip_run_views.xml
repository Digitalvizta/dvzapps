<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dvz_wip_run_view_form" model="ir.ui.view">
        <field name="name">dvz.wip.run.form</field>
        <field name="model">dvz.wip.run</field>
        <field name="arch" type="xml">
            <form string="WIP Run">
                <header>
                    <button name="action_compute" string="Calculate" type="object" invisible="state != 'draft'"/>
                    <button name="action_post" string="Post Journal Entry" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'posted'"
                            confirm="This cancels the WIP journal entry and its reversal. Continue?"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="fa-book" invisible="not move_id">
                            <div class="o_stat_info"><span class="o_stat_text">Journal Entries</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="total_earned"/>
                            <field name="total_billed"/>
                            <field name="total_under"/>
                            <field name="total_over"/>
                            <field name="total_provision" invisible="not total_provision"/>
                        </group>
                    </group>
                    <p class="text-muted" invisible="state != 'draft'">
                        For each running contract: progress % × contract value = revenue earned. Earned minus invoiced work
                        is booked as unbilled revenue (asset) or billings in excess (liability) on the period end date and
                        reversed the next day, so the next month starts clean. Expected losses are provided for in full.
                        Change the progress % on a line if needed, then post.
                    </p>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom" create="0" decoration-danger="loss_provision &gt; 0">
                            <field name="currency_id" column_invisible="True"/>
                            <field name="contract_id" readonly="1"/>
                            <field name="partner_id" optional="hide"/>
                            <field name="method" optional="show"/>
                            <field name="contract_value" readonly="1" sum="Total"/>
                            <field name="cost_to_date" readonly="1" sum="Total" optional="show"/>
                            <field name="forecast_cost" readonly="1" sum="Total" optional="show"/>
                            <field name="percent" widget="progressbar" options="{'editable': true}"/>
                            <field name="earned" sum="Total"/>
                            <field name="certified" readonly="1" optional="hide"/>
                            <field name="billed" readonly="1" sum="Total"/>
                            <field name="adjustment" sum="Total" decoration-success="adjustment &gt; 0" decoration-warning="adjustment &lt; 0"/>
                            <field name="position" widget="badge" decoration-success="position == 'under'" decoration-warning="position == 'over'"/>
                            <field name="loss_provision" sum="Total" optional="show"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Notes for the auditors..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="dvz_wip_run_view_list" model="ir.ui.view">
        <field name="name">dvz.wip.run.list</field>
        <field name="model">dvz.wip.run</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'">
                <field name="date"/>
                <field name="name"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total_earned"/>
                <field name="total_billed"/>
                <field name="total_under"/>
                <field name="total_over"/>
                <field name="total_provision" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>
    <record id="action_dvz_wip_run" model="ir.actions.act_window">
        <field name="name">Revenue Recognition (WIP)</field>
        <field name="res_model">dvz.wip.run</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Run your first month-end WIP</p>
            <p>Recognise contract revenue by progress (IFRS 15): see what each contract earned, what was invoiced,
               and book the difference with one journal entry that reverses itself the next day.</p>
        </field>
    </record>

    <record id="dvz_wip_line_view_list" model="ir.ui.view">
        <field name="name">dvz.wip.line.list</field>
        <field name="model">dvz.wip.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/>
                <field name="run_id"/>
                <field name="contract_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="percent" widget="progressbar"/>
                <field name="earned"/>
                <field name="billed"/>
                <field name="adjustment"/>
                <field name="position" widget="badge" decoration-success="position == 'under'" decoration-warning="position == 'over'"/>
                <field name="loss_provision" optional="show"/>
                <field name="run_state" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="dvz_wip_line_view_graph" model="ir.ui.view">
        <field name="name">dvz.wip.line.graph</field>
        <field name="model">dvz.wip.line</field>
        <field name="arch" type="xml">
            <graph string="WIP" type="line">
                <field name="date" interval="month"/>
                <field name="earned" type="measure"/>
                <field name="billed" type="measure"/>
            </graph>
        </field>
    </record>
</odoo>
