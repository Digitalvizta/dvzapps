<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_manpower_documents" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.manpower.documents</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="dvz_manpower_supply.res_config_settings_view_form_manpower"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='dvz_manpower_supply']" position="inside">
                <block title="Worker Documents" name="dv_documents_setting_container">
                    <setting id="dv_doc_alert_days_setting" string="Expiry alerts"
                             help="Create a renewal to-do this many days before a document expires.">
                        <field name="dv_doc_alert_days"/> days before expiry
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
