<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dvz_rfi_company_rule" model="ir.rule">
        <field name="name">RFIs: multi-company</field>
        <field name="model_id" ref="model_dvz_rfi"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="dvz_submittal_company_rule" model="ir.rule">
        <field name="name">Submittals: multi-company</field>
        <field name="model_id" ref="model_dvz_submittal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="dvz_transmittal_company_rule" model="ir.rule">
        <field name="name">Transmittals: multi-company</field>
        <field name="model_id" ref="model_dvz_transmittal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
