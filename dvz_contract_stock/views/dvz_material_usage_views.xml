<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dvz_material_usage_view_list" model="ir.ui.view">
        <field name="name">dvz.material.usage.list</field>
        <field name="model">dvz.material.usage</field>
        <field name="arch" type="xml">
            <list string="Material Usage" decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="project_id" optional="show"/>
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_total" sum="Total" groups="dvz_contract.group_dvz_show_cost"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-success="state == 'done'" decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="dvz_material_usage_view_form" model="ir.ui.view">
        <field name="name">dvz.material.usage.form</field>
        <field name="model">dvz.material.usage</field>
        <field name="arch" type="xml">
            <form string="Material Used on Site">
                <header>
                    <button name="action_done" string="Confirm Usage" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancel'"
                            confirm="Cancelling a confirmed usage puts the material back in the site store. Continue?"/>
                    <button name="action_draft" string="Back to Draft" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="project_id"/>
                            <field name="site_location_id"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materials" name="materials">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" decoration-warning="usage_type == 'wastage'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="contract_id" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="contract_line_id" options="{'no_create': True}"/>
                                    <field name="product_id"/>
                                    <field name="name" optional="show"/>
                                    <field name="usage_type"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" optional="show"/>
                                    <field name="qty_on_site" optional="show"/>
                                    <field name="subtotal" sum="Total" groups="dvz_contract.group_dvz_show_cost"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" groups="dvz_contract.group_dvz_show_cost">
                                <field name="amount_total"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dvz_material_usage_view_search" model="ir.ui.view">
        <field name="name">dvz.material.usage.search</field>
        <field name="model">dvz.material.usage</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contract_id"/>
                <field name="project_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="my" string="My Records" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="group_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dvz_material_usage" model="ir.actions.act_window">
        <field name="name">Material Usage</field>
        <field name="res_model">dvz.material.usage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record material used on site</p>
            <p>Site teams record what was used or wasted per BOQ item. Confirming takes it out of the site store.</p>
        </field>
    </record>

    <!-- Analysis: usage per BOQ item -->
    <record id="dvz_material_usage_line_view_list" model="ir.ui.view">
        <field name="name">dvz.material.usage.line.list</field>
        <field name="model">dvz.material.usage.line</field>
        <field name="arch" type="xml">
            <list string="Material Usage" create="0" edit="0" delete="0" decoration-warning="usage_type == 'wastage'">
                <field name="date"/>
                <field name="usage_id"/>
                <field name="contract_id"/>
                <field name="contract_line_id"/>
                <field name="product_id"/>
                <field name="usage_type"/>
                <field name="quantity" sum="Total"/>
                <field name="uom_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="subtotal" sum="Total" groups="dvz_contract.group_dvz_show_cost"/>
            </list>
        </field>
    </record>

    <record id="dvz_material_usage_line_view_pivot" model="ir.ui.view">
        <field name="name">dvz.material.usage.line.pivot</field>
        <field name="model">dvz.material.usage.line</field>
        <field name="arch" type="xml">
            <pivot string="Material Usage" sample="1">
                <field name="contract_id" type="row"/>
                <field name="usage_type" type="col"/>
                <field name="subtotal" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="dvz_material_usage_line_view_search" model="ir.ui.view">
        <field name="name">dvz.material.usage.line.search</field>
        <field name="model">dvz.material.usage.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="contract_id"/>
                <field name="contract_line_id"/>
                <field name="product_id"/>
                <filter name="used" string="Used" domain="[('usage_type', '=', 'used')]"/>
                <filter name="wastage" string="Wastage" domain="[('usage_type', '=', 'wastage')]"/>
                <group>
                    <filter name="group_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                    <filter name="group_boq" string="BOQ Item" context="{'group_by': 'contract_line_id'}"/>
                    <filter name="group_product" string="Material" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dvz_material_usage_analysis" model="ir.actions.act_window">
        <field name="name">Material Used per BOQ Item</field>
        <field name="res_model">dvz.material.usage.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('usage_id.state', '=', 'done')]</field>
        <field name="search_view_id" ref="dvz_material_usage_line_view_search"/>
    </record>
</odoo>
