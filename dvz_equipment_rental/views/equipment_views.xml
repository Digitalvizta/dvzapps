<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categories -->
    <record id="view_equipment_category_list" model="ir.ui.view">
        <field name="name">dvz.equipment.category.list</field>
        <field name="model">dvz.equipment.category</field>
        <field name="arch" type="xml">
            <list string="Equipment Categories" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="equipment_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_equipment_category" model="ir.actions.act_window">
        <field name="name">Equipment Categories</field>
        <field name="res_model">dvz.equipment.category</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Equipment -->
    <record id="view_equipment_list" model="ir.ui.view">
        <field name="name">dvz.equipment.list</field>
        <field name="model">dvz.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipment">
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="make" optional="show"/>
                <field name="model_name" optional="show"/>
                <field name="plate_number" optional="show"/>
                <field name="capacity" optional="hide"/>
                <field name="hour_meter" optional="show"/>
                <field name="current_partner_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="rate_day" optional="hide"/>
                <field name="rate_month" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-info="state == 'on_rent'"
                       decoration-warning="state == 'maintenance'"
                       decoration-muted="state == 'retired'"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_kanban" model="ir.ui.view">
        <field name="name">dvz.equipment.kanban</field>
        <field name="model">dvz.equipment</field>
        <field name="arch" type="xml">
            <kanban sample="1" default_group_by="state">
                <field name="state"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="me-2">
                            <field name="image_128" widget="image" options="{'size': [64, 64]}"/>
                        </aside>
                        <main>
                            <field name="name" class="fw-bold"/>
                            <div class="text-muted">
                                <field name="code"/> · <field name="category_id"/>
                            </div>
                            <div><field name="make"/> <field name="model_name"/></div>
                            <div t-if="record.current_partner_id.raw_value" class="text-primary">
                                <i class="fa fa-map-marker me-1" title="Client"/><field name="current_partner_id"/>
                            </div>
                            <footer>
                                <span class="text-muted"><field name="hour_meter"/> h</span>
                                <field name="activity_ids" widget="kanban_activity"/>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_equipment_form" model="ir.ui.view">
        <field name="name">dvz.equipment.form</field>
        <field name="model">dvz.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipment">
                <header>
                    <button name="action_set_maintenance" type="object" string="Send to Maintenance"
                            invisible="state != 'available'"/>
                    <button name="action_set_available" type="object" string="Back in Service"
                            class="btn-primary" invisible="state != 'maintenance'"/>
                    <button name="action_retire" type="object" string="Retire"
                            invisible="state not in ('available', 'maintenance')"
                            confirm="Retire this machine? It will be archived."/>
                    <field name="state" widget="statusbar" statusbar_visible="available,on_rent,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rentals" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="rental_count" widget="statinfo" string="Rentals"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_128" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Mobile Crane 50 Ton"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="category_id"/>
                            <field name="make"/>
                            <field name="model_name"/>
                            <field name="year"/>
                            <field name="serial_number"/>
                            <field name="plate_number"/>
                            <field name="capacity"/>
                        </group>
                        <group string="Usage">
                            <field name="hour_meter"/>
                            <field name="current_contract_id"/>
                            <field name="current_partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rental Rates" name="rates">
                            <group>
                                <group>
                                    <field name="rate_hour"/>
                                    <field name="rate_day"/>
                                </group>
                                <group>
                                    <field name="rate_week"/>
                                    <field name="rate_month"/>
                                </group>
                            </group>
                        </page>
                        <page string="Rental History" name="history">
                            <field name="rental_line_ids" readonly="1">
                                <list>
                                    <field name="contract_id"/>
                                    <field name="partner_id"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="rate_type"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="rate"/>
                                    <field name="meter_used"/>
                                    <field name="contract_state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_equipment_search" model="ir.ui.view">
        <field name="name">dvz.equipment.search</field>
        <field name="model">dvz.equipment</field>
        <field name="arch" type="xml">
            <search string="Equipment">
                <field name="name" filter_domain="['|', '|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('plate_number', 'ilike', self), ('serial_number', 'ilike', self)]"/>
                <field name="category_id"/>
                <filter name="filter_available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="filter_on_rent" string="On Rent" domain="[('state', '=', 'on_rent')]"/>
                <filter name="filter_maintenance" string="In Maintenance" domain="[('state', '=', 'maintenance')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_equipment" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">dvz.equipment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first machine</p>
            <p>Add cranes, excavators, loaders, trucks or generators with their rental rates.</p>
        </field>
    </record>
</odoo>
