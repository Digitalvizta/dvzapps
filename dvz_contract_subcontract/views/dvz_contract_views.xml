<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main (client) contract: subcontracts smart button -->
    <record id="dvz_contract_view_form_subcontract" model="ir.ui.view">
        <field name="name">dvz.contract.form.subcontract</field>
        <field name="model">dvz.contract</field>
        <field name="inherit_id" ref="dvz_contract.dvz_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_handover']" position="before">
                <button name="action_new_subcontract" type="object" string="New subcontract"
                        invisible="contract_type != 'customer' or state not in ('draft', 'running')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_subcontracts" type="object" class="oe_stat_button" icon="fa-users"
                        invisible="not subcontract_count">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="subcontract_count"/></span>
                        <span class="o_stat_text">Subcontracts</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//group[@name='budget']" position="inside">
                <field name="subcontract_amount" invisible="contract_type != 'customer'"/>
            </xpath>
        </field>
    </record>

    <!-- Subcontract form (primary view) -->
    <record id="dvz_subcontract_view_form" model="ir.ui.view">
        <field name="name">dvz.contract.form.subcontractor</field>
        <field name="model">dvz.contract</field>
        <field name="inherit_id" ref="dvz_contract.dvz_contract_view_form"/>
        <field name="mode">primary</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">Subcontractor</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="parent_contract_id" options="{'no_create': True}"
                       readonly="state not in ('draft', 'running')"/>
            </xpath>
            <xpath expr="//field[@name='client_reference']" position="attributes">
                <attribute name="string">Subcontract reference</attribute>
            </xpath>
        </field>
    </record>

    <record id="dvz_subcontract_view_list" model="ir.ui.view">
        <field name="name">dvz.contract.list.subcontractor</field>
        <field name="model">dvz.contract</field>
        <field name="inherit_id" ref="dvz_contract.dvz_contract_view_list"/>
        <field name="mode">primary</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="string">Subcontractor</attribute>
            </field>
            <field name="partner_id" position="after">
                <field name="parent_contract_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="action_dvz_subcontract" model="ir.actions.act_window">
        <field name="name">Subcontracts</field>
        <field name="res_model">dvz.contract</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="domain">[('contract_type', '=', 'subcontract')]</field>
        <field name="context">{'default_contract_type': 'subcontract', 'search_default_active_contracts': 1}</field>
        <field name="search_view_id" ref="dvz_contract.dvz_contract_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first subcontract</p>
            <p>Link it to the main contract, add the subcontract BOQ and certify the subcontractor's progress.</p>
        </field>
    </record>
    <record id="action_dvz_subcontract_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="dvz_subcontract_view_list"/>
        <field name="act_window_id" ref="action_dvz_subcontract"/>
    </record>
    <record id="action_dvz_subcontract_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="dvz_subcontract_view_form"/>
        <field name="act_window_id" ref="action_dvz_subcontract"/>
    </record>
</odoo>
