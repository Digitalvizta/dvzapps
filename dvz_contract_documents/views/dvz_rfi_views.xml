<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dvz_rfi_view_form" model="ir.ui.view">
        <field name="name">dvz.rfi.form</field>
        <field name="model">dvz.rfi</field>
        <field name="arch" type="xml">
            <form string="Request for Information">
                <header>
                    <button name="action_send" string="Send to Consultant" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_mark_answered" string="Record Answer" type="object" invisible="state != 'sent'"
                            help="Type the answer you received by letter or email in the Answer tab, then press this."/>
                    <button name="action_create_variation" string="Create Variation Order" type="object"
                            invisible="state not in ('answered', 'closed') or not (cost_impact or time_impact) or variation_id"/>
                    <button name="action_close" string="Close" type="object" invisible="state not in ('answered', 'sent')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('closed', 'cancel')"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,answered,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_variation" type="object" class="oe_stat_button" icon="fa-exchange" invisible="not variation_id">
                            <div class="o_stat_info"><field name="variation_id" readonly="1" nolabel="1" class="o_stat_value"/><span class="o_stat_text">Variation</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/> <field name="priority" widget="priority" class="ms-2"/></h1>
                        <field name="subject" placeholder="e.g. Clarify slab thickness at grid C/4-6" readonly="state not in ('draft',)"/>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="discipline" readonly="state != 'draft'"/>
                            <field name="reference" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="date_sent" invisible="not date_sent"/>
                            <field name="date_required"/>
                            <field name="days_open" invisible="not date_sent"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Question" name="question">
                            <field name="question" readonly="state != 'draft'" placeholder="What do you need clarified?"/>
                            <label for="proposed_solution" class="fw-bold mt-3"/>
                            <field name="proposed_solution" readonly="state != 'draft'" placeholder="Your suggested solution (optional)"/>
                            <label for="attachment_ids" class="fw-bold mt-3"/>
                            <field name="attachment_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                        </page>
                        <page string="Answer" name="answer">
                            <group invisible="not answered_by_id">
                                <field name="answered_by_id"/>
                                <field name="answer_date"/>
                            </group>
                            <field name="answer" readonly="state not in ('sent',)" placeholder="The consultant's answer"/>
                            <label for="answer_attachment_ids" class="fw-bold mt-3"/>
                            <field name="answer_attachment_ids" widget="many2many_binary" readonly="state != 'sent'"/>
                        </page>
                        <page string="Impact" name="impact">
                            <group>
                                <group>
                                    <field name="cost_impact"/>
                                    <field name="time_impact"/>
                                    <field name="impact_days" invisible="not time_impact"/>
                                </group>
                                <group>
                                    <p class="text-muted" colspan="2">If the answer changes the scope, cost or time, create a
                                        variation order from this RFI. The question and answer are copied into it.</p>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="dvz_rfi_view_list" model="ir.ui.view">
        <field name="name">dvz.rfi.list</field>
        <field name="model">dvz.rfi</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state in ('closed', 'cancel')">
                <field name="priority" widget="priority" optional="show"/>
                <field name="name"/>
                <field name="subject"/>
                <field name="contract_id"/>
                <field name="discipline" optional="show"/>
                <field name="date_sent" optional="show"/>
                <field name="date_required"/>
                <field name="days_open" optional="hide"/>
                <field name="is_overdue" column_invisible="True"/>
                <field name="cost_impact" optional="hide"/>
                <field name="time_impact" optional="hide"/>
                <field name="user_id" optional="hide" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-warning="state == 'sent'" decoration-success="state in ('answered', 'closed')"/>
            </list>
        </field>
    </record>
    <record id="dvz_rfi_view_search" model="ir.ui.view">
        <field name="name">dvz.rfi.search</field>
        <field name="model">dvz.rfi</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subject"/>
                <field name="contract_id"/>
                <filter string="Waiting for answer" name="open" domain="[('state', '=', 'sent')]"/>
                <filter string="Overdue" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Cost or time impact" name="impact" domain="['|', ('cost_impact', '=', True), ('time_impact', '=', True)]"/>
                <group name="groupby">
                    <filter string="Contract" name="group_contract" context="{'group_by': 'contract_id'}"/>
                    <filter string="Discipline" name="group_discipline" context="{'group_by': 'discipline'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dvz_rfi" model="ir.actions.act_window">
        <field name="name">RFIs</field>
        <field name="res_model">dvz.rfi</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ask the consultant your first question</p>
            <p>Each RFI gets a number, a due date and an overdue alert. The consultant answers in the portal,
               and an answer that changes cost or time becomes a variation order in one click.</p>
        </field>
    </record>
</odoo>
