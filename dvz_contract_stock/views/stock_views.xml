<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock on sites -->
    <record id="dvz_site_quant_view_list" model="ir.ui.view">
        <field name="name">stock.quant.list.dvz.site</field>
        <field name="model">stock.quant</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <list string="Stock on Site" create="0" edit="0" delete="0">
                <field name="dvz_site_contract_id"/>
                <field name="location_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total"/>
                <field name="reserved_quantity" optional="hide"/>
                <field name="product_uom_id"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="dvz_site_quant_view_search" model="ir.ui.view">
        <field name="name">stock.quant.search.dvz.site</field>
        <field name="model">stock.quant</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <search>
                <field name="dvz_site_contract_id"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <filter name="positive" string="In Stock" domain="[('quantity', '&gt;', 0)]"/>
                <group>
                    <filter name="group_site" string="Contract Site" context="{'group_by': 'dvz_site_contract_id'}"/>
                    <filter name="group_product" string="Material" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dvz_site_stock" model="ir.actions.act_window">
        <field name="name">Stock on Sites</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="domain">[('dvz_site_contract_id', '!=', False)]</field>
        <field name="search_view_id" ref="dvz_site_quant_view_search"/>
        <field name="context">{'search_default_positive': 1, 'search_default_group_site': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('dvz_site_quant_view_list')})]"/>
    </record>

    <!-- Transfers that touch a site store -->
    <record id="action_dvz_site_transfers" model="ir.actions.act_window">
        <field name="name">Site Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('location_id.dvz_site_contract_id', '!=', False), ('location_dest_id.dvz_site_contract_id', '!=', False)]</field>
        <field name="context">{'restricted_picking_type_code': 'internal'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No site transfers yet</p>
            <p>Use "Transfer Material" or "Return Leftovers to Store" on a contract to move material between sites
                and the main store.</p>
        </field>
    </record>

    <!-- Show the contract on locations -->
    <record id="view_location_form_dvz_site" model="ir.ui.view">
        <field name="name">stock.location.form.dvz.site</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='usage']" position="after">
                <field name="dvz_site_contract_id" invisible="not dvz_site_contract_id"/>
            </xpath>
        </field>
    </record>
</odoo>
