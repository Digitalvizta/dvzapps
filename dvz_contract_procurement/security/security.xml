<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dvz_material_request_company_rule" model="ir.rule">
        <field name="name">Material requests: multi-company</field>
        <field name="model_id" ref="model_dvz_material_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="dvz_material_request_line_company_rule" model="ir.rule">
        <field name="name">Material request lines: multi-company</field>
        <field name="model_id" ref="model_dvz_material_request_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
