<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dvz_retention_release" model="ir.sequence">
            <field name="name">Retention release</field>
            <field name="code">dvz.retention.release</field>
            <field name="prefix">RR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="ir_cron_dvz_guarantee_reminders" model="ir.cron">
            <field name="name">Contracting: bank guarantee expiry</field>
            <field name="model_id" ref="model_dvz_bank_guarantee"/>
            <field name="state">code</field>
            <field name="code">model._cron_guarantee_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_dvz_dlp_reminders" model="ir.cron">
            <field name="name">Contracting: defects period / final retention reminders</field>
            <field name="model_id" ref="dvz_contract.model_dvz_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_dlp_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
