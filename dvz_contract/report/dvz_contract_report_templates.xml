<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_dvz_contract_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <t t-set="address">
                <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name", "vat"], "no_marker": True}'/>
            </t>
            <div class="page">
                <h2>Contract <span t-field="o.name"/></h2>
                <h4 t-field="o.title"/>
                <div class="row mt-3 mb-3">
                    <div class="col-3" t-if="o.client_reference"><strong>Reference</strong><div t-field="o.client_reference"/></div>
                    <div class="col-3" t-if="o.project_id"><strong>Project</strong><div t-field="o.project_id"/></div>
                    <div class="col-3" t-if="o.date_signed"><strong>Signed</strong><div t-field="o.date_signed"/></div>
                    <div class="col-3" t-if="o.date_end"><strong>Planned completion</strong><div t-field="o.date_end"/></div>
                </div>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th class="text-start">Item</th>
                            <th class="text-start">Description</th>
                            <th class="text-center">Unit</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Rate</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.line_ids" t-as="line">
                            <tr t-if="line.display_type == 'line_section'" class="bg-200 fw-bold o_line_section">
                                <td colspan="6"><span t-field="line.name"/></td>
                            </tr>
                            <tr t-elif="line.display_type == 'line_note'" class="fst-italic o_line_note">
                                <td colspan="6"><span t-field="line.name"/></td>
                            </tr>
                            <tr t-else="">
                                <td><span t-field="line.code"/></td>
                                <td><span t-field="line.name"/></td>
                                <td class="text-center"><span t-field="line.uom_id"/></td>
                                <td class="text-end"><span t-field="line.quantity"/></td>
                                <td class="text-end"><span t-field="line.price_unit"/></td>
                                <td class="text-end"><span t-field="line.amount"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <div class="row justify-content-end">
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr><td>Original value</td><td class="text-end"><span t-field="o.amount_original"/></td></tr>
                            <tr t-if="o.amount_variation"><td>Variations</td><td class="text-end"><span t-field="o.amount_variation"/></td></tr>
                            <tr class="border-top fw-bold"><td>Contract value (excl. tax)</td><td class="text-end"><span t-field="o.amount_total"/></td></tr>
                        </table>
                    </div>
                </div>
                <h5 class="mt-4">Commercial terms</h5>
                <ul>
                    <li t-if="o.retention_percent">Retention: <t t-out="o.retention_percent"/>% of each certificate</li>
                    <li t-if="o.advance_amount">Advance payment: <span t-field="o.advance_amount"/> (recovered at <t t-out="o.advance_recovery_percent"/>% per certificate)</li>
                    <li t-if="o.dlp_months">Defects liability period: <t t-out="o.dlp_months"/> months after handover</li>
                    <li t-if="o.tax_ids">Taxes: <t t-out="', '.join(o.tax_ids.mapped('name'))"/></li>
                </ul>
                <p t-if="o.payment_terms_note" t-field="o.payment_terms_note"/>
                <div t-if="o.note" class="mt-3" t-field="o.note"/>
            </div>
        </t>
    </template>

    <template id="report_dvz_contract">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="dvz_contract.report_dvz_contract_document"/>
            </t>
        </t>
    </template>
</odoo>
