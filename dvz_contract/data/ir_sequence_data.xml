<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_dvz_contract" model="ir.sequence">
        <field name="name">Client contracts</field>
        <field name="code">dvz.contract</field>
        <field name="prefix">CON/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_dvz_contract_sub" model="ir.sequence">
        <field name="name">Subcontracts</field>
        <field name="code">dvz.contract.sub</field>
        <field name="prefix">SUB/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
