<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_manpower" model="ir.ui.view">
        <field name="name">hr.employee.form.manpower</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dv_view_assignments" type="object" class="oe_stat_button"
                        icon="fa-handshake-o" groups="dv_manpower_supply.group_manpower_user">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="dv_assignment_count"/></span>
                        <span class="o_stat_text">Assignments</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="action_manpower_workers" model="ir.actions.act_window">
        <field name="name">Workers</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
