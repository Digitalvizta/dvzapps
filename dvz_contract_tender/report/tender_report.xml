<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_dvz_tender" model="ir.actions.report">
        <field name="name">Tender Offer</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dvz_contract_tender.report_dvz_tender</field>
        <field name="report_file">dvz_contract_tender.report_dvz_tender</field>
        <field name="print_report_name">'Tender Offer - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_dvz_tender_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <t t-set="cur" t-value="doc.currency_id"/>
            <div class="page" style="font-size: 12px;">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h3 class="mb-0">Tender Offer <span dir="rtl" style="font-size: 16px;">/ عرض مناقصة</span></h3>
                        <div><b t-out="doc.name"/> · Revision <span t-out="doc.dvz_revision_label"/></div>
                        <div t-if="doc.dvz_project_title" class="mt-1"><b>Project / المشروع:</b> <span t-out="doc.dvz_project_title"/></div>
                    </div>
                    <div class="text-end">
                        <div><b>Date / التاريخ:</b> <span t-field="doc.date_order" t-options="{'widget': 'date'}"/></div>
                        <div t-if="doc.validity_date"><b>Valid until / صالح حتى:</b> <span t-field="doc.validity_date"/></div>
                        <div t-if="doc.dvz_closing_date"><b>Submission deadline:</b> <span t-field="doc.dvz_closing_date"/></div>
                    </div>
                </div>
                <div class="mb-3">
                    <b>To / إلى:</b>
                    <div t-field="doc.partner_id" t-options="{'widget': 'contact', 'fields': ['name', 'address', 'vat'], 'no_marker': True}"/>
                </div>

                <table class="table table-sm o_main_table">
                    <thead style="display: table-row-group">
                        <tr>
                            <th>Item<br/><span dir="rtl">البند</span></th>
                            <th>Description<br/><span dir="rtl">الوصف</span></th>
                            <th>Unit<br/><span dir="rtl">الوحدة</span></th>
                            <th class="text-end">Qty<br/><span dir="rtl">الكمية</span></th>
                            <th class="text-end">Rate<br/><span dir="rtl">السعر</span></th>
                            <th class="text-end">Amount<br/><span dir="rtl">المبلغ</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.order_line.sorted(lambda l: (l.sequence, l.id))" t-as="line">
                            <tr t-if="line.display_type in ('line_section', 'line_subsection')" style="background-color: #eef3f8;">
                                <td colspan="6"><b t-out="line.name"/></td>
                            </tr>
                            <tr t-elif="line.display_type == 'line_note'">
                                <td colspan="6"><i t-out="line.name"/></td>
                            </tr>
                            <tr t-elif="not line.is_downpayment">
                                <td><span t-out="line.dvz_item_no"/></td>
                                <td><span t-out="line.name"/></td>
                                <td><span t-out="line.dvz_uom_id.name or line.product_uom_id.name"/></td>
                                <td class="text-end"><span t-out="'{:,.2f}'.format(line.product_uom_qty)"/></td>
                                <td class="text-end"><span t-field="line.price_unit"/></td>
                                <td class="text-end"><span t-field="line.price_subtotal"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="row justify-content-end">
                    <div class="col-6">
                        <table class="table table-sm">
                            <tr><td>Total excl. VAT <span dir="rtl">/ الإجمالي قبل الضريبة</span></td>
                                <td class="text-end"><span t-field="doc.amount_untaxed"/></td></tr>
                            <tr><td>VAT <span dir="rtl">/ ضريبة القيمة المضافة</span></td>
                                <td class="text-end"><span t-field="doc.amount_tax"/></td></tr>
                            <tr class="fw-bold"><td>Total incl. VAT <span dir="rtl">/ الإجمالي شامل الضريبة</span></td>
                                <td class="text-end"><span t-field="doc.amount_total"/></td></tr>
                        </table>
                    </div>
                </div>

                <h5 class="mt-3">Commercial Terms <span dir="rtl" style="font-size: 13px;">/ الشروط التجارية</span></h5>
                <table class="table table-sm" style="width: 70%;">
                    <tr><td>Retention</td><td><span t-out="'%.0f' % doc.dvz_retention_percent"/>% of each payment certificate</td></tr>
                    <tr t-if="doc.dvz_advance_percent"><td>Advance payment</td>
                        <td><span t-out="'%.0f' % doc.dvz_advance_percent"/>%, recovered at <span t-out="'%.0f' % doc.dvz_advance_recovery_percent"/>% of each certificate</td></tr>
                    <tr t-if="doc.dvz_duration_months"><td>Duration</td><td><span t-out="doc.dvz_duration_months"/> months</td></tr>
                    <tr><td>Defects liability</td><td><span t-out="doc.dvz_defects_months"/> months after handover</td></tr>
                    <tr t-if="doc.payment_term_id"><td>Payment terms</td><td><span t-out="doc.payment_term_id.name"/></td></tr>
                </table>

                <div t-if="doc.dvz_scope and doc.dvz_scope != '&lt;p&gt;&lt;br&gt;&lt;/p&gt;'" class="mt-2">
                    <h5>Scope &amp; Inclusions</h5>
                    <div t-field="doc.dvz_scope"/>
                </div>
                <div t-if="doc.dvz_exclusions" class="mt-2">
                    <h5>Exclusions &amp; Assumptions</h5>
                    <div t-field="doc.dvz_exclusions"/>
                </div>
                <div t-if="doc.note" class="mt-2">
                    <h5>Terms &amp; Conditions</h5>
                    <div t-field="doc.note"/>
                </div>

                <div class="row mt-5" style="page-break-inside: avoid;">
                    <div class="col-6">
                        <b>For <span t-out="doc.company_id.name"/></b><br/><br/><br/>
                        ______________________________<br/>Name, signature and stamp
                    </div>
                    <div class="col-6">
                        <b>Accepted by <span t-out="doc.partner_id.commercial_partner_id.name"/></b><br/><br/><br/>
                        ______________________________<br/>Name, signature and stamp
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_dvz_tender">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="dvz_contract_tender.report_dvz_tender_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
