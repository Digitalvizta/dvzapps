<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dvz_bank_guarantee_view_list" model="ir.ui.view">
        <field name="name">dvz.bank.guarantee.list</field>
        <field name="model">dvz.bank.guarantee</field>
        <field name="arch" type="xml">
            <list string="Bank guarantees" decoration-danger="state == 'active' and days_to_expiry &lt; 0"
                  decoration-warning="state == 'active' and days_to_expiry &lt;= 30" decoration-muted="state in ('released', 'expired')">
                <field name="name"/>
                <field name="guarantee_type"/>
                <field name="direction" optional="show"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="bank_id" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="date_expiry"/>
                <field name="days_to_expiry" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'claimed'"/>
            </list>
        </field>
    </record>

    <record id="dvz_bank_guarantee_view_form" model="ir.ui.view">
        <field name="name">dvz.bank.guarantee.form</field>
        <field name="model">dvz.bank.guarantee</field>
        <field name="arch" type="xml">
            <form string="Bank guarantee">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_release" type="object" string="Release" invisible="state not in ('active', 'expired')"/>
                    <button name="action_claim" type="object" string="Claimed" invisible="state != 'active'"
                            groups="dvz_contract.group_contract_manager" confirm="Mark this guarantee as claimed / encashed?"/>
                    <button name="action_draft" type="object" string="Reset to draft" invisible="state == 'draft'"
                            groups="dvz_contract.group_contract_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,released"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Guarantee number"/></h1></div>
                    <group>
                        <group>
                            <field name="guarantee_type"/>
                            <field name="direction" widget="radio"/>
                            <field name="contract_id" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="bank_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="percent_of_contract" invisible="not contract_id"/>
                            <field name="commission_amount"/>
                            <field name="date_issue"/>
                            <field name="date_expiry"/>
                            <field name="days_to_expiry" invisible="state != 'active'"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Conditions, extensions, reference letters..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dvz_bank_guarantee_view_search" model="ir.ui.view">
        <field name="name">dvz.bank.guarantee.search</field>
        <field name="model">dvz.bank.guarantee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="bank_id"/>
                <filter string="Active" name="active_g" domain="[('state', '=', 'active')]"/>
                <filter string="Given" name="given" domain="[('direction', '=', 'given')]"/>
                <filter string="Received" name="received" domain="[('direction', '=', 'received')]"/>
                <separator/>
                <filter string="Expiry date" name="date_expiry" date="date_expiry"/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by': 'guarantee_type'}"/>
                    <filter string="Bank" name="group_bank" context="{'group_by': 'bank_id'}"/>
                    <filter string="Expiry month" name="group_expiry" context="{'group_by': 'date_expiry:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dvz_bank_guarantee_view_calendar" model="ir.ui.view">
        <field name="name">dvz.bank.guarantee.calendar</field>
        <field name="model">dvz.bank.guarantee</field>
        <field name="arch" type="xml">
            <calendar string="Guarantee expiry" date_start="date_expiry" mode="month" quick_create="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount"/>
            </calendar>
        </field>
    </record>

    <record id="action_dvz_bank_guarantee" model="ir.actions.act_window">
        <field name="name">Bank guarantees</field>
        <field name="res_model">dvz.bank.guarantee</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="dvz_bank_guarantee_view_search"/>
        <field name="context">{'search_default_active_g': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first bank guarantee</p>
            <p>Track bid, performance, advance and retention bonds with expiry reminders.</p>
        </field>
    </record>
</odoo>
