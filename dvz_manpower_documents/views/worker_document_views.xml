<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_worker_document_list" model="ir.ui.view">
        <field name="name">dvz.worker.document.list</field>
        <field name="model">dvz.worker.document</field>
        <field name="arch" type="xml">
            <list string="Worker Documents"
                  decoration-danger="status == 'expired'"
                  decoration-warning="status == 'expiring'">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="doc_type"/>
                <field name="number"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry" string="Days Left"/>
                <field name="partner_id" optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'valid'"
                       decoration-warning="status == 'expiring'"
                       decoration-danger="status == 'expired'"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_worker_document_form" model="ir.ui.view">
        <field name="name">dvz.worker.document.form</field>
        <field name="model">dvz.worker.document</field>
        <field name="arch" type="xml">
            <form string="Worker Document">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="valid,expiring,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_label" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="doc_type"/>
                            <field name="number"/>
                            <field name="contract_id" invisible="doc_type != 'ajeer'"/>
                            <field name="partner_id" invisible="doc_type != 'ajeer'"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry" string="Days Left" invisible="not expiry_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Scanned Copies">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_worker_document_search" model="ir.ui.view">
        <field name="name">dvz.worker.document.search</field>
        <field name="model">dvz.worker.document</field>
        <field name="arch" type="xml">
            <search string="Worker Documents">
                <field name="employee_id"/>
                <field name="number"/>
                <field name="partner_id"/>
                <filter name="filter_expiring" string="Expiring Soon" domain="[('status', '=', 'expiring')]"/>
                <filter name="filter_expired" string="Expired" domain="[('status', '=', 'expired')]"/>
                <filter name="filter_attention" string="Needs Action" domain="[('status', 'in', ('expiring', 'expired'))]"/>
                <separator/>
                <filter name="filter_iqama" string="Iqama" domain="[('doc_type', '=', 'iqama')]"/>
                <filter name="filter_ajeer" string="Ajeer Permits" domain="[('doc_type', '=', 'ajeer')]"/>
                <filter name="filter_passport" string="Passports" domain="[('doc_type', '=', 'passport')]"/>
                <group>
                    <filter name="group_type" string="Document Type" context="{'group_by': 'doc_type'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_employee" string="Worker" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_worker_document" model="ir.actions.act_window">
        <field name="name">Worker Documents</field>
        <field name="res_model">dvz.worker.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_attention': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No documents need action</p>
            <p>Record Iqama, passport, Ajeer permits and more. You will get a to-do before each one expires.</p>
        </field>
    </record>

    <!-- Employee form: smart button + warning -->
    <record id="view_employee_form_manpower_documents" model="ir.ui.view">
        <field name="name">hr.employee.form.manpower.documents</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dv_view_documents" type="object" class="oe_stat_button"
                        icon="fa-id-card" groups="dvz_manpower_supply.group_manpower_user">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="dv_document_count"/></span>
                        <span class="o_stat_text">Documents</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Assignment: warn when the worker has expired documents -->
    <record id="view_manpower_assignment_form_documents" model="ir.ui.view">
        <field name="name">dvz.manpower.assignment.form.documents</field>
        <field name="model">dvz.manpower.assignment</field>
        <field name="inherit_id" ref="dvz_manpower_supply.view_manpower_assignment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0" role="alert" invisible="not documents_expired">
                    This worker has expired documents (Iqama, Ajeer, passport...). Renew them before the assignment.
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_manpower_assignment_list_documents" model="ir.ui.view">
        <field name="name">dvz.manpower.assignment.list.documents</field>
        <field name="model">dvz.manpower.assignment</field>
        <field name="inherit_id" ref="dvz_manpower_supply.view_manpower_assignment_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">documents_expired</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="documents_expired" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_worker_documents" name="Worker Documents"
              parent="dvz_manpower_supply.menu_manpower_operations"
              action="action_worker_document" sequence="40"/>
</odoo>
