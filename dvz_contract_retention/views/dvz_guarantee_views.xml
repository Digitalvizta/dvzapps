<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dvz_bank_guarantee_view_form" model="ir.ui.view">
        <field name="name">dvz.bank.guarantee.form</field>
        <field name="model">dvz.bank.guarantee</field>
        <field name="arch" type="xml">
            <form string="Bank Guarantee">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_release" string="Mark Released" type="object" invisible="state not in ('active', 'expired')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('cancel', 'released')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,released"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" invisible="expiry_status != 'expired' or state != 'active'"/>
                    <widget name="web_ribbon" title="Expiring soon" bg_color="text-bg-warning" invisible="expiry_status != 'soon' or state != 'active'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. LG-2026-0451"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="guarantee_type"/>
                            <field name="direction" widget="radio"/>
                            <field name="contract_id"/>
                            <field name="partner_id"/>
                            <field name="bank_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="commission_percent"/>
                            <field name="commission_amount"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry"/>
                            <field name="expiry_status" invisible="1"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dvz_bank_guarantee_view_list" model="ir.ui.view">
        <field name="name">dvz.bank.guarantee.list</field>
        <field name="model">dvz.bank.guarantee</field>
        <field name="arch" type="xml">
            <list string="Bank Guarantees" decoration-danger="state == 'expired' or (state == 'active' and expiry_status == 'expired')"
                  decoration-warning="state == 'active' and expiry_status == 'soon'" decoration-muted="state in ('released', 'cancel')">
                <field name="name"/>
                <field name="guarantee_type"/>
                <field name="direction" optional="show"/>
                <field name="contract_id"/>
                <field name="partner_id" optional="show"/>
                <field name="bank_id" optional="show"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry" optional="show"/>
                <field name="expiry_status" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
                <field name="commission_amount" optional="hide" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="dvz_bank_guarantee_view_calendar" model="ir.ui.view">
        <field name="name">dvz.bank.guarantee.calendar</field>
        <field name="model">dvz.bank.guarantee</field>
        <field name="arch" type="xml">
            <calendar string="Guarantee Expiry" date_start="expiry_date" mode="month" quick_create="0">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="amount"/>
            </calendar>
        </field>
    </record>

    <record id="dvz_bank_guarantee_view_search" model="ir.ui.view">
        <field name="name">dvz.bank.guarantee.search</field>
        <field name="model">dvz.bank.guarantee</field>
        <field name="arch" type="xml">
            <search string="Bank Guarantees">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="bank_id"/>
                <filter name="active_g" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="given" string="Given" domain="[('direction', '=', 'given')]"/>
                <filter name="received" string="Received" domain="[('direction', '=', 'received')]"/>
                <filter name="expiry" string="Expiry Date" date="expiry_date"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'guarantee_type'}"/>
                    <filter name="group_bank" string="Bank" context="{'group_by': 'bank_id'}"/>
                    <filter name="group_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dvz_bank_guarantee" model="ir.actions.act_window">
        <field name="name">Bank Guarantees</field>
        <field name="res_model">dvz.bank.guarantee</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="dvz_bank_guarantee_view_search"/>
        <field name="context">{'search_default_active_g': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first bank guarantee</p>
            <p>Bid, performance, advance and retention bonds, given or received, with expiry reminders.</p>
        </field>
    </record>
</odoo>
