<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_equipment_maintenance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.equipment.maintenance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="dvz_equipment_rental.res_config_settings_view_form_equipment"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='dvz_equipment_rental']" position="inside">
                <block title="Maintenance &amp; Documents" name="dv_eq_maintenance_container">
                    <setting id="dv_eq_doc_alert_days_setting" string="Document expiry alerts"
                             help="Create a renewal to-do this many days before registration, insurance or TPI expires.">
                        <field name="dv_eq_doc_alert_days"/> days before expiry
                    </setting>
                    <setting id="dv_eq_service_alert_hours_setting" string="Service due alerts"
                             help="Warn this many engine hours before the next preventive service.">
                        <field name="dv_eq_service_alert_hours"/> hours before service
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
