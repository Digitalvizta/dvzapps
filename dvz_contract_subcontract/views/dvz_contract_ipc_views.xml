<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_dvz_subcontract_ipc" model="ir.actions.act_window">
        <field name="name">Subcontractor certificates</field>
        <field name="res_model">dvz.contract.ipc</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="domain">[('contract_type', '=', 'subcontract')]</field>
        <field name="search_view_id" ref="dvz_contract_ipc.dvz_contract_ipc_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No subcontractor certificates yet</p>
            <p>Open a subcontract in progress and click New certificate. Approved certificates become vendor bills.</p>
        </field>
    </record>
</odoo>
