<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_equipment_logsheet_company" model="ir.rule">
            <field name="name">Equipment log sheet: multi-company</field>
            <field name="model_id" ref="model_dvz_equipment_logsheet"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_equipment_logsheet_portal" model="ir.rule">
            <field name="name">Equipment log sheet: portal client sees own sent log sheets</field>
            <field name="model_id" ref="model_dvz_equipment_logsheet"/>
            <field name="domain_force">[('partner_id', 'child_of', [user.commercial_partner_id.id]), ('state', '!=', 'draft')]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        <record id="rule_equipment_logsheet_line_portal" model="ir.rule">
            <field name="name">Equipment log sheet line: portal client</field>
            <field name="model_id" ref="model_dvz_equipment_logsheet_line"/>
            <field name="domain_force">[('sheet_id.partner_id', 'child_of', [user.commercial_partner_id.id]), ('sheet_id.state', '!=', 'draft')]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>
