<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_contracting" model="ir.module.category">
        <field name="name">Contracting</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_contracting" model="res.groups.privilege">
        <field name="name">Contracting</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_contracting"/>
    </record>

    <record id="group_dvz_contract_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_contracting"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_dvz_contract_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_contracting"/>
        <field name="implied_ids" eval="[(4, ref('group_dvz_contract_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_dvz_show_cost" model="res.groups">
        <field name="name">Show estimated cost on BOQ</field>
    </record>

    <record id="dvz_contract_company_rule" model="ir.rule">
        <field name="name">Contracts: multi-company</field>
        <field name="model_id" ref="model_dvz_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="dvz_contract_line_company_rule" model="ir.rule">
        <field name="name">BOQ lines: multi-company</field>
        <field name="model_id" ref="model_dvz_contract_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
