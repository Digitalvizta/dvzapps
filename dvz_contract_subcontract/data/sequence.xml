<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_dvz_subcontract" model="ir.sequence">
        <field name="name">Subcontract</field>
        <field name="code">dvz.contract.subcontract</field>
        <field name="prefix">SUB/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_dvz_subcontract_certificate" model="ir.sequence">
        <field name="name">Subcontractor Certificate</field>
        <field name="code">dvz.contract.certificate.sub</field>
        <field name="prefix">SPC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
