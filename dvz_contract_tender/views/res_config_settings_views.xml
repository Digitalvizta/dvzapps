<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tender" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dvz_contract_tender</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="dvz_contract.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='dvz_contract_defaults']" position="before">
                <block title="Tendering &amp; Estimation" name="dvz_tender">
                    <setting id="dvz_tender_pricing" string="Default overhead and profit" help="Used to calculate tender rates from the direct cost">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="dvz_tender_overhead_percent" string="Overhead %" class="col-lg-5 o_light_label"/>
                                <field name="dvz_tender_overhead_percent"/>
                            </div>
                            <div class="row">
                                <label for="dvz_tender_profit_percent" string="Profit %" class="col-lg-5 o_light_label"/>
                                <field name="dvz_tender_profit_percent"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="dvz_tender_bid_bond" string="Bid bond %" help="Proposed amount of the bid bond, as % of the tender value">
                        <field name="dvz_tender_bid_bond_percent"/>
                    </setting>
                    <setting id="dvz_tender_product" string="BOQ item product" help="Technical product put on every tender line">
                        <field name="dvz_tender_product_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
