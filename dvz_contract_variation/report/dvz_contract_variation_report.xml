<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_dvz_contract_variation" model="ir.actions.report">
        <field name="name">Variation order</field>
        <field name="model">dvz.contract.variation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dvz_contract_variation.report_dvz_contract_variation</field>
        <field name="report_file">dvz_contract_variation.report_dvz_contract_variation</field>
        <field name="print_report_name">'Variation - %s' % (object.name or '').replace('/', '-')</field>
        <field name="binding_model_id" ref="model_dvz_contract_variation"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_dvz_contract_variation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h3>Variation order <span t-field="o.name"/></h3>
                        <h5 t-field="o.title"/>
                        <table class="table table-sm table-borderless">
                            <tr><td class="w-25"><strong>Contract</strong></td><td><span t-field="o.contract_id"/></td>
                                <td class="w-25"><strong>Instruction</strong></td><td><span t-field="o.instruction_ref"/> <span t-field="o.date_instruction"/></td></tr>
                            <tr><td><strong>Reason</strong></td><td><span t-field="o.reason"/></td>
                                <td><strong>Time extension</strong></td><td><t t-out="o.extension_days"/> days</td></tr>
                        </table>
                        <table class="table table-sm o_main_table">
                            <thead><tr><th>Type</th><th>Item</th><th>Description</th><th>Unit</th>
                                <th class="text-end">Qty</th><th class="text-end">Rate</th><th class="text-end">Value</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="l">
                                    <td><span t-field="l.change_type"/></td>
                                    <td><span t-field="l.code"/></td>
                                    <td><span t-field="l.name"/></td>
                                    <td><span t-field="l.uom_id"/></td>
                                    <td class="text-end"><t t-out="l.quantity if l.change_type == 'add' else l.quantity_change"/></td>
                                    <td class="text-end"><span t-field="l.price_unit"/></td>
                                    <td class="text-end"><span t-field="l.amount_change"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="text-end fw-bold">Total variation: <span t-field="o.amount_total"/></p>
                        <div t-if="o.description" t-field="o.description"/>
                        <div class="row mt-5 text-center">
                            <div class="col-6">Contractor<br/><br/>________________</div>
                            <div class="col-6">Client / Engineer<br/><br/>________________</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
