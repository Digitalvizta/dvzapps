<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_contract_list" model="ir.ui.view">
        <field name="name">dvz.rental.contract.list</field>
        <field name="model">dvz.rental.contract</field>
        <field name="arch" type="xml">
            <list string="Rental Contracts" decoration-danger="is_overdue">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="equipment_count" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'on_rent'"
                       decoration-muted="state in ('returned', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_rental_contract_form" model="ir.ui.view">
        <field name="name">dvz.rental.contract.form</field>
        <field name="model">dvz.rental.contract</field>
        <field name="arch" type="xml">
            <form string="Rental Contract">
                <header>
                    <button name="action_confirm" type="object" string="Confirm &amp; Reserve"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_dispatch" type="object" string="Dispatch to Site"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_return" type="object" string="Return Equipment"
                            class="btn-primary" invisible="state != 'on_rent'"
                            confirm="Mark all equipment of this rental as returned today?"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_draft" type="object" string="Reset to Quotation"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,on_rent,returned"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="client_reference"/>
                            <field name="site"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="date_end"/>
                            <field name="mobilization_fee"/>
                            <field name="demobilization_fee"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="is_overdue" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipment" name="equipment">
                            <field name="line_ids" readonly="state in ('returned', 'cancelled')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="equipment_id"/>
                                    <field name="category_id" optional="hide"/>
                                    <field name="rate_type"/>
                                    <field name="rate"/>
                                    <field name="with_operator"/>
                                    <field name="operator_name" optional="show"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="meter_out" optional="show"/>
                                    <field name="meter_in" optional="show"/>
                                    <field name="meter_used" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Terms &amp; Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rental_contract_search" model="ir.ui.view">
        <field name="name">dvz.rental.contract.search</field>
        <field name="model">dvz.rental.contract</field>
        <field name="arch" type="xml">
            <search string="Rental Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site"/>
                <field name="line_ids" string="Equipment" filter_domain="[('line_ids.equipment_id', 'ilike', self)]"/>
                <filter name="filter_open" string="Reserved or On Rent" domain="[('state', 'in', ('confirmed', 'on_rent'))]"/>
                <filter name="filter_on_rent" string="On Rent" domain="[('state', '=', 'on_rent')]"/>
                <filter name="filter_draft" string="Quotations" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_overdue" string="Overdue Return" domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <filter name="filter_my" string="My Rentals" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rental_contract" model="ir.actions.act_window">
        <field name="name">Rental Contracts</field>
        <field name="res_model">dvz.rental.contract</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first rental</p>
            <p>Pick the client and site, add the machines with their rates, then confirm and dispatch.</p>
        </field>
    </record>

    <!-- Rental schedule on lines -->
    <record id="view_rental_line_calendar" model="ir.ui.view">
        <field name="name">dvz.rental.contract.line.calendar</field>
        <field name="model">dvz.rental.contract.line</field>
        <field name="arch" type="xml">
            <calendar string="Rental Schedule" date_start="date_from" date_stop="date_to"
                      color="equipment_id" mode="month" quick_create="0" event_open_popup="1">
                <field name="equipment_id" filters="1"/>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <field name="contract_state"/>
            </calendar>
        </field>
    </record>

    <record id="view_rental_line_list" model="ir.ui.view">
        <field name="name">dvz.rental.contract.line.list</field>
        <field name="model">dvz.rental.contract.line</field>
        <field name="arch" type="xml">
            <list string="Rented Equipment" create="0">
                <field name="equipment_id"/>
                <field name="category_id" optional="show"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="rate_type"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="rate"/>
                <field name="with_operator" optional="show"/>
                <field name="contract_state" widget="badge"
                       decoration-info="contract_state == 'confirmed'"
                       decoration-success="contract_state == 'on_rent'"/>
            </list>
        </field>
    </record>

    <record id="view_rental_line_form" model="ir.ui.view">
        <field name="name">dvz.rental.contract.line.form</field>
        <field name="model">dvz.rental.contract.line</field>
        <field name="arch" type="xml">
            <form string="Rented Equipment" create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="equipment_id" readonly="1"/>
                            <field name="contract_id" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="operator_name"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="rate_type" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="rate" readonly="1"/>
                            <field name="contract_state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rental_line_search" model="ir.ui.view">
        <field name="name">dvz.rental.contract.line.search</field>
        <field name="model">dvz.rental.contract.line</field>
        <field name="arch" type="xml">
            <search string="Rental Schedule">
                <field name="equipment_id"/>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <filter name="filter_booked" string="Reserved or On Rent"
                        domain="[('contract_state', 'in', ('confirmed', 'on_rent'))]"/>
                <group>
                    <filter name="group_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rental_schedule" model="ir.actions.act_window">
        <field name="name">Rental Schedule</field>
        <field name="res_model">dvz.rental.contract.line</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{'search_default_filter_booked': 1}</field>
    </record>
</odoo>
