<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_retention" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dvz_contract_retention</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="dvz_contract_ipc.res_config_settings_view_form_ipc"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='dvz_ipc']" position="after">
                <block title="Retention &amp; Guarantees" name="dvz_retention">
                    <setting id="dvz_release_at_handover" help="Prepare a retention release draft when the contract is handed over">
                        <field name="dvz_release_at_handover"/>
                        <div class="content-group" invisible="not dvz_release_at_handover">
                            <div class="row mt8">
                                <label for="dvz_release_handover_percent" string="% of held" class="col-lg-5 o_light_label"/>
                                <field name="dvz_release_handover_percent"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="dvz_dlp_reminder" string="Defects period reminder" help="Days before the defects period ends">
                        <field name="dvz_dlp_reminder_days"/>
                    </setting>
                    <setting id="dvz_guarantee_reminder" string="Guarantee expiry reminder" help="Days before a guarantee expires">
                        <field name="dvz_guarantee_reminder_days"/>
                    </setting>
                    <setting id="dvz_guarantee_auto_expire" help="Mark guarantees as expired after the expiry date">
                        <field name="dvz_guarantee_auto_expire"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
