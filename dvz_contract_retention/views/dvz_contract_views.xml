<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dvz_contract_view_form_retention" model="ir.ui.view">
        <field name="name">dvz.contract.form.retention</field>
        <field name="model">dvz.contract</field>
        <field name="inherit_id" ref="dvz_contract_ipc.dvz_contract_view_form_ipc"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_close']" position="before">
                <button name="action_new_release" type="object" string="Release retention"
                        invisible="state not in ('handover', 'closed') or retention_balance &lt;= 0"
                        groups="dvz_contract.group_contract_manager"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_releases" type="object" class="oe_stat_button" icon="fa-unlock"
                        invisible="not release_count">
                    <field name="release_count" widget="statinfo" string="Releases"/>
                </button>
                <button name="action_view_guarantees" type="object" class="oe_stat_button" icon="fa-shield">
                    <field name="guarantee_count" widget="statinfo" string="Guarantees"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='retention_held']" position="after">
                <field name="retention_released"/>
                <field name="retention_balance"/>
            </xpath>
        </field>
    </record>
</odoo>
