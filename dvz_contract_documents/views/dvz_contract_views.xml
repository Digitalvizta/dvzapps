<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dvz_contract_view_form_documents" model="ir.ui.view">
        <field name="name">dvz.contract.form.documents</field>
        <field name="model">dvz.contract</field>
        <field name="inherit_id" ref="dvz_contract.dvz_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_rfis" type="object" class="oe_stat_button" icon="fa-question-circle">
                    <field name="rfi_open_count" widget="statinfo" string="Open RFIs"/>
                </button>
                <button name="action_view_submittals" type="object" class="oe_stat_button" icon="fa-files-o">
                    <field name="submittal_open_count" widget="statinfo" string="Under Review"/>
                </button>
                <button name="action_view_transmittals" type="object" class="oe_stat_button" icon="fa-paper-plane-o">
                    <div class="o_stat_info"><span class="o_stat_text">Transmittals</span></div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
