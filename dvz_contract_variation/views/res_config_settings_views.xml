<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dvz_variation" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dvz_contract_variation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="dvz_contract.res_config_settings_view_form_dvz_contract"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='dvz_contract_boq']" position="inside">
                <setting id="dvz_vo_approval" help="Variation orders go to a manager for approval.">
                    <field name="dvz_vo_approval_required"/>
                </setting>
                <setting id="dvz_vo_auto_apply" help="Update the BOQ and contract value as soon as a variation is approved.">
                    <field name="dvz_vo_auto_apply"/>
                </setting>
                <setting id="dvz_vo_negative" help="Allow variations that reduce the contract value.">
                    <field name="dvz_vo_allow_negative"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
