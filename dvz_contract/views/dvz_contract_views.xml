<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= LIST ================= -->
    <record id="dvz_contract_view_list" model="ir.ui.view">
        <field name="name">dvz.contract.list</field>
        <field name="model">dvz.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts" decoration-muted="state in ('closed', 'cancel')" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="contract_type" optional="hide"/>
                <field name="project_id" optional="show"/>
                <field name="date_signed" optional="show"/>
                <field name="date_end" optional="hide"/>
                <field name="user_id" optional="hide" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="amount_total" sum="Total" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'" decoration-success="state == 'running'"
                       decoration-warning="state == 'handover'"/>
            </list>
        </field>
    </record>

    <!-- ================= FORM ================= -->
    <record id="dvz_contract_view_form" model="ir.ui.view">
        <field name="name">dvz.contract.form</field>
        <field name="model">dvz.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <button name="action_confirm" type="object" string="Confirm contract" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_handover" type="object" string="Handover"
                            invisible="state != 'running'"
                            confirm="Mark the works as handed over (taking-over)?"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state not in ('handover', 'running')"
                            groups="dvz_contract.group_contract_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancel', 'closed')"
                            groups="dvz_contract.group_contract_manager"/>
                    <button name="action_draft" type="object" string="Reset to draft"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,handover,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_boq_lines" type="object" class="oe_stat_button" icon="fa-list-ol">
                            <field name="line_count" widget="statinfo" string="BOQ items"/>
                        </button>
                        <button name="action_view_analytic_lines" type="object" class="oe_stat_button"
                                icon="fa-bar-chart" invisible="not analytic_account_id">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="budget_consumed_percent" widget="integer"/>%</span>
                                <span class="o_stat_text">Budget used</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancel'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="title" placeholder="e.g. Tower B fit-out works"/></h3>
                    </div>
                    <group>
                        <group name="main_left">
                            <field name="contract_type" invisible="1"/>
                            <field name="partner_id" readonly="state not in ('draft', 'running')"/>
                            <field name="client_reference"/>
                            <field name="project_id" readonly="state not in ('draft', 'running')"/>
                            <field name="analytic_account_id" groups="analytic.group_analytic_accounting"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group name="main_right">
                            <field name="date_signed"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="date_handover" invisible="state in ('draft', 'running')"/>
                            <field name="date_dlp_end" invisible="not date_handover"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" groups="base.group_multi_currency" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group class="oe_subtotal_footer" name="values">
                        <field name="amount_original"/>
                        <field name="amount_variation" invisible="not amount_variation"/>
                        <field name="amount_total" class="oe_subtotal_footer_separator"/>
                    </group>
                    <notebook>
                        <page string="Bill of quantities" name="boq">
                            <field name="boq_locked" invisible="1"/>
                            <field name="line_ids" widget="section_and_note_one2many" mode="list" readonly="boq_locked">
                                <list editable="bottom" string="BOQ">
                                    <control>
                                        <create name="add_line_control" string="Add an item"/>
                                        <create name="add_section_control" string="Add a section"
                                                context="{'default_display_type': 'line_section'}"/>
                                        <create name="add_note_control" string="Add a note"
                                                context="{'default_display_type': 'line_note'}"/>
                                    </control>
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_type" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="code" optional="show"/>
                                    <field name="product_id" optional="hide"/>
                                    <field name="name" widget="section_and_note_text"/>
                                    <field name="uom_id" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="cost_price" optional="show" groups="dvz_contract.group_boq_cost"/>
                                    <field name="cost_amount" optional="show" sum="Total cost" groups="dvz_contract.group_boq_cost"/>
                                    <field name="origin" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Commercial terms" name="terms">
                            <group>
                                <group string="Payments" name="payments">
                                    <field name="retention_percent"/>
                                    <field name="advance_percent"/>
                                    <field name="advance_amount"/>
                                    <field name="advance_recovery_percent"/>
                                    <field name="tax_ids" widget="many2many_tags"
                                           domain="[('type_tax_use', '=', 'purchase' if contract_type == 'subcontract' else 'sale')]"/>
                                </group>
                                <group string="Handover" name="handover">
                                    <field name="dlp_months"/>
                                </group>
                            </group>
                            <label for="payment_terms_note"/>
                            <field name="payment_terms_note" placeholder="e.g. Monthly certificates, payment within 60 days of certification"/>
                        </page>
                        <page string="Cost control" name="cost_control">
                            <group>
                                <group string="Budget" name="budget">
                                    <field name="cost_budget"/>
                                    <field name="margin_planned"/>
                                    <field name="margin_planned_percent"/>
                                </group>
                                <group string="Actual" name="actual">
                                    <field name="cost_committed"/>
                                    <field name="cost_actual"/>
                                    <field name="cost_forecast"/>
                                    <field name="revenue_actual"/>
                                    <field name="budget_consumed_percent" widget="progressbar"/>
                                </group>
                            </group>
                            <p class="text-muted" invisible="analytic_account_id">
                                Confirm the contract (or set an analytic account) to track actual cost and revenue.
                            </p>
                        </page>
                        <page string="Scope &amp; notes" name="notes">
                            <field name="note" placeholder="Scope of work, exclusions, special conditions..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= SEARCH ================= -->
    <record id="dvz_contract_view_search" model="ir.ui.view">
        <field name="name">dvz.contract.search</field>
        <field name="model">dvz.contract</field>
        <field name="arch" type="xml">
            <search string="Contracts">
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="client_reference"/>
                <filter string="My contracts" name="my" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In progress" name="running" domain="[('state', '=', 'running')]"/>
                <filter string="Handed over" name="handover" domain="[('state', '=', 'handover')]"/>
                <filter string="Active" name="active_contracts" domain="[('state', 'in', ('running', 'handover'))]"/>
                <separator/>
                <filter string="Signing date" name="date_signed" date="date_signed"/>
                <group>
                    <filter string="Client" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Manager" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Signing month" name="group_date" context="{'group_by': 'date_signed:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================= PIVOT / GRAPH ================= -->
    <record id="dvz_contract_view_pivot" model="ir.ui.view">
        <field name="name">dvz.contract.pivot</field>
        <field name="model">dvz.contract</field>
        <field name="arch" type="xml">
            <pivot string="Contract analysis" sample="1">
                <field name="partner_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="cost_budget" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="dvz_contract_view_graph" model="ir.ui.view">
        <field name="name">dvz.contract.graph</field>
        <field name="model">dvz.contract</field>
        <field name="arch" type="xml">
            <graph string="Contract value" type="bar" sample="1">
                <field name="partner_id"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ================= ACTIONS ================= -->
    <record id="action_dvz_contract" model="ir.actions.act_window">
        <field name="name">Client contracts</field>
        <field name="res_model">dvz.contract</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="domain">[('contract_type', '=', 'customer')]</field>
        <field name="context">{'default_contract_type': 'customer', 'search_default_active_contracts': 1}</field>
        <field name="search_view_id" ref="dvz_contract_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first contract</p>
            <p>Add the bill of quantities, set retention and advance terms, then confirm to start billing.</p>
        </field>
    </record>

    <record id="action_dvz_contract_analysis" model="ir.actions.act_window">
        <field name="name">Contract analysis</field>
        <field name="res_model">dvz.contract</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="dvz_contract_view_search"/>
    </record>

    <record id="action_dvz_contract_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'dvz_contract', 'bin_size': False}</field>
    </record>
</odoo>
