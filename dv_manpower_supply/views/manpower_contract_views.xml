<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_manpower_contract_list" model="ir.ui.view">
        <field name="name">dv.manpower.contract.list</field>
        <field name="model">dv.manpower.contract</field>
        <field name="arch" type="xml">
            <list string="Supply Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="required_workers" optional="show"/>
                <field name="assigned_workers" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'expired'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_manpower_contract_form" model="ir.ui.view">
        <field name="name">dv.manpower.contract.form</field>
        <field name="model">dv.manpower.contract</field>
        <field name="arch" type="xml">
            <form string="Supply Contract">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'active')"
                            confirm="Cancel this contract? Active assignments will be ended."/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assignments" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="assigned_workers"/> / <field name="required_workers"/>
                                </span>
                                <span class="o_stat_text">Workers</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="client_reference"/>
                            <field name="site"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rates" name="rates">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="job_id"/>
                                    <field name="quantity"/>
                                    <field name="rate_type"/>
                                    <field name="rate"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Workers" name="workers">
                            <field name="assignment_ids" context="{'default_contract_id': id}">
                                <list editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="job_id"/>
                                    <field name="site"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-info="state == 'planned'"/>
                                    <button name="action_start" type="object" string="Start"
                                            icon="fa-play" invisible="state != 'planned'"/>
                                    <button name="action_end" type="object" string="End"
                                            icon="fa-stop" invisible="state != 'active'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Terms &amp; Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_manpower_contract_search" model="ir.ui.view">
        <field name="name">dv.manpower.contract.search</field>
        <field name="model">dv.manpower.contract</field>
        <field name="arch" type="xml">
            <search string="Supply Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter name="filter_my" string="My Contracts" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_manpower_contract" model="ir.actions.act_window">
        <field name="name">Supply Contracts</field>
        <field name="res_model">dv.manpower.contract</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first manpower supply contract</p>
            <p>Add the client, the job positions with their rates, then assign your workers.</p>
        </field>
    </record>
</odoo>
