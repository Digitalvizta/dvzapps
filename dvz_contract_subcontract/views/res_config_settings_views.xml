<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dvz_subcontract" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dvz_contract_subcontract</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="dvz_contract_ipc.res_config_settings_view_form_dvz_ipc"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='dvz_contract_ipc_accounting']" position="after">
                <block title="Subcontractors" name="dvz_contract_subcontract">
                    <setting id="dvz_sub_analytic" help="Post subcontract costs to the main contract's analytic account.">
                        <field name="dvz_sub_inherit_analytic"/>
                    </setting>
                    <setting string="Vendor bills" help="Journal, product and cost account for subcontractor certificates.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="dvz_sub_journal_id" class="col-lg-5 o_light_label" string="Journal"/>
                                <field name="dvz_sub_journal_id" options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="dvz_sub_product_id" class="col-lg-5 o_light_label" string="Product"/>
                                <field name="dvz_sub_product_id" options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="dvz_sub_expense_account_id" class="col-lg-5 o_light_label" string="Cost account"/>
                                <field name="dvz_sub_expense_account_id" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Vendor-side accounts" help="Retention payable, advances paid and back-charges.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="dvz_sub_retention_account_id" class="col-lg-5 o_light_label" string="Retention payable"/>
                                <field name="dvz_sub_retention_account_id" options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="dvz_sub_advance_account_id" class="col-lg-5 o_light_label" string="Advances paid"/>
                                <field name="dvz_sub_advance_account_id" options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="dvz_sub_deduction_account_id" class="col-lg-5 o_light_label" string="Back-charges"/>
                                <field name="dvz_sub_deduction_account_id" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
