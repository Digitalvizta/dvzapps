<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dvz_tender_lost_view_form" model="ir.ui.view">
        <field name="name">dvz.tender.lost.form</field>
        <field name="model">dvz.tender.lost</field>
        <field name="arch" type="xml">
            <form string="Tender Lost">
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="lost_reason_id" options="{'no_create_edit': True}"/>
                    <field name="note" placeholder="e.g. Competitor price 6% lower"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Mark as Lost" type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
