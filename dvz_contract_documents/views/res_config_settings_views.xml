<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_documents" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dvz_contract_documents</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="dvz_contract.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='dvz_contract_boq']" position="after">
                <block title="Document Control" name="dvz_documents">
                    <setting id="dvz_rfi_days" string="RFI answer time" help="Days the consultant has to answer an RFI (due date)">
                        <field name="dvz_rfi_days"/> days
                    </setting>
                    <setting id="dvz_submittal_days" string="Submittal review time" help="Days the consultant has to review a submittal">
                        <field name="dvz_submittal_days"/> days
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
