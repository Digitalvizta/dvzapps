<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_manpower_contract_form_timesheet" model="ir.ui.view">
        <field name="name">dv.manpower.contract.form.timesheet</field>
        <field name="model">dv.manpower.contract</field>
        <field name="inherit_id" ref="dv_manpower_supply.view_manpower_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_timesheets" type="object" class="oe_stat_button" icon="fa-clock-o">
                    <field name="timesheet_count" widget="statinfo" string="Timesheets"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
