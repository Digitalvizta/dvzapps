<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_document_list" model="ir.ui.view">
        <field name="name">dvz.equipment.document.list</field>
        <field name="model">dvz.equipment.document</field>
        <field name="arch" type="xml">
            <list string="Equipment Documents"
                  decoration-danger="status == 'expired'"
                  decoration-warning="status == 'expiring'">
                <field name="equipment_id"/>
                <field name="doc_type"/>
                <field name="number"/>
                <field name="issuer" optional="hide"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry" string="Days Left"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'valid'"
                       decoration-warning="status == 'expiring'"
                       decoration-danger="status == 'expired'"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_document_form" model="ir.ui.view">
        <field name="name">dvz.equipment.document.form</field>
        <field name="model">dvz.equipment.document</field>
        <field name="arch" type="xml">
            <form string="Equipment Document">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="valid,expiring,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_label" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="doc_type"/>
                            <field name="number"/>
                            <field name="issuer"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry" invisible="not expiry_date"/>
                            <field name="blocks_dispatch"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Scanned Copies">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1" colspan="2"/>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_equipment_document_search" model="ir.ui.view">
        <field name="name">dvz.equipment.document.search</field>
        <field name="model">dvz.equipment.document</field>
        <field name="arch" type="xml">
            <search string="Equipment Documents">
                <field name="equipment_id"/>
                <field name="number"/>
                <filter name="filter_needs_action" string="Needs Action" domain="[('status', 'in', ('expiring', 'expired'))]"/>
                <filter name="filter_expired" string="Expired" domain="[('status', '=', 'expired')]"/>
                <separator/>
                <filter name="filter_registration" string="Registration" domain="[('doc_type', '=', 'registration')]"/>
                <filter name="filter_insurance" string="Insurance" domain="[('doc_type', '=', 'insurance')]"/>
                <filter name="filter_tpi" string="TPI" domain="[('doc_type', '=', 'tpi')]"/>
                <group>
                    <filter name="group_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'doc_type'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_equipment_document" model="ir.actions.act_window">
        <field name="name">Equipment Documents</field>
        <field name="res_model">dvz.equipment.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add registration, insurance and TPI documents</p>
            <p>You get a to-do before each document expires.</p>
        </field>
    </record>

    <record id="action_equipment_document_needs_action" model="ir.actions.act_window">
        <field name="name">Documents Needing Action</field>
        <field name="res_model">dvz.equipment.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_needs_action': 1}</field>
    </record>

    <menuitem id="menu_equipment_documents" name="Equipment Documents"
              parent="menu_equipment_maintenance" action="action_equipment_document" sequence="30"/>
    <menuitem id="menu_equipment_documents_action" name="Documents Needing Action"
              parent="menu_equipment_maintenance" action="action_equipment_document_needs_action" sequence="40"/>
</odoo>
