<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dvz_wip_run_company_rule" model="ir.rule">
        <field name="name">WIP runs: multi-company</field>
        <field name="model_id" ref="model_dvz_wip_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="dvz_wip_line_company_rule" model="ir.rule">
        <field name="name">WIP lines: multi-company</field>
        <field name="model_id" ref="model_dvz_wip_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
