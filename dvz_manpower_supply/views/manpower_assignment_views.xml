<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_manpower_assignment_list" model="ir.ui.view">
        <field name="name">dvz.manpower.assignment.list</field>
        <field name="model">dvz.manpower.assignment</field>
        <field name="arch" type="xml">
            <list string="Worker Assignments">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="job_id"/>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <field name="site" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'planned'"
                       decoration-muted="state == 'ended'"/>
            </list>
        </field>
    </record>

    <record id="view_manpower_assignment_form" model="ir.ui.view">
        <field name="name">dvz.manpower.assignment.form</field>
        <field name="model">dvz.manpower.assignment</field>
        <field name="arch" type="xml">
            <form string="Worker Assignment">
                <header>
                    <button name="action_start" type="object" string="Start Assignment"
                            class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_end" type="object" string="End Assignment"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="job_id"/>
                            <field name="contract_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="site"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_manpower_assignment_search" model="ir.ui.view">
        <field name="name">dvz.manpower.assignment.search</field>
        <field name="model">dvz.manpower.assignment</field>
        <field name="arch" type="xml">
            <search string="Worker Assignments">
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_planned" string="Planned" domain="[('state', '=', 'planned')]"/>
                <group>
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_job" string="Job Position" context="{'group_by': 'job_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_manpower_assignment" model="ir.actions.act_window">
        <field name="name">Worker Assignments</field>
        <field name="res_model">dvz.manpower.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>
