<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_contract_user" model="res.groups">
        <field name="name">Contracting: User</field>
        <field name="comment">Create and manage contracts, BOQ and payment certificates.</field>
    </record>

    <record id="group_contract_manager" model="res.groups">
        <field name="name">Contracting: Manager</field>
        <field name="comment">Approve certificates and variations, change contracting settings.</field>
        <field name="implied_ids" eval="[(4, ref('group_contract_user'))]"/>
    </record>

    <record id="group_boq_cost" model="res.groups">
        <field name="name">Contracting: Show estimated cost on BOQ</field>
    </record>

    <!-- Internal users get basic contracting access; administrators get manager rights. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_contract_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_contract_manager'))]"/>
    </record>

    <record id="dvz_contract_company_rule" model="ir.rule">
        <field name="name">Contracts: multi-company</field>
        <field name="model_id" ref="model_dvz_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="dvz_contract_line_company_rule" model="ir.rule">
        <field name="name">BOQ lines: multi-company</field>
        <field name="model_id" ref="model_dvz_contract_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
