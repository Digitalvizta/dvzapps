<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_equipment_document_expiry" model="ir.cron">
            <field name="name">Equipment Rental: Check Document Expiry</field>
            <field name="model_id" ref="model_dvz_equipment_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
        <record id="ir_cron_equipment_service_due" model="ir.cron">
            <field name="name">Equipment Rental: Check Service Due</field>
            <field name="model_id" ref="dvz_equipment_rental.model_dvz_equipment"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_service_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
