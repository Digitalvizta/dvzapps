<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_equipment_rental" model="res.groups.privilege">
        <field name="name">Equipment Rental</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_equipment_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_equipment_rental"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_equipment_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_equipment_rental"/>
        <field name="implied_ids" eval="[(4, ref('group_equipment_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_equipment_company" model="ir.rule">
            <field name="name">Equipment: multi-company</field>
            <field name="model_id" ref="model_dvz_equipment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_equipment_category_company" model="ir.rule">
            <field name="name">Equipment category: multi-company</field>
            <field name="model_id" ref="model_dvz_equipment_category"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_rental_contract_company" model="ir.rule">
            <field name="name">Rental contract: multi-company</field>
            <field name="model_id" ref="model_dvz_rental_contract"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_rental_contract_line_company" model="ir.rule">
            <field name="name">Rental contract line: multi-company</field>
            <field name="model_id" ref="model_dvz_rental_contract_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
