<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dvz_contract_view_form_tender" model="ir.ui.view">
        <field name="name">dvz.contract.form.tender</field>
        <field name="model">dvz.contract</field>
        <field name="inherit_id" ref="dvz_contract.dvz_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_dvz_view_tender" type="object" class="oe_stat_button" icon="fa-gavel"
                        invisible="not dvz_sale_order_id" groups="sales_team.group_sale_salesman">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="dvz_sale_order_id" readonly="1" nolabel="1"
                                                          options="{'no_open': True}"/></span>
                        <span class="o_stat_text">Tender</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="dvz_bank_guarantee_view_form_tender" model="ir.ui.view">
        <field name="name">dvz.bank.guarantee.form.tender</field>
        <field name="model">dvz.bank.guarantee</field>
        <field name="inherit_id" ref="dvz_contract_retention.dvz_bank_guarantee_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contract_id']" position="after">
                <field name="dvz_sale_order_id" invisible="not dvz_sale_order_id and guarantee_type != 'bid'"
                       groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>
</odoo>
