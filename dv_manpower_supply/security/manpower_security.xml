<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_manpower" model="res.groups.privilege">
        <field name="name">Manpower Supply</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_manpower_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_manpower"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_manpower_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_manpower"/>
        <field name="implied_ids" eval="[(4, ref('group_manpower_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_manpower_contract_company" model="ir.rule">
            <field name="name">Manpower contract: multi-company</field>
            <field name="model_id" ref="model_dv_manpower_contract"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_manpower_assignment_company" model="ir.rule">
            <field name="name">Manpower assignment: multi-company</field>
            <field name="model_id" ref="model_dv_manpower_assignment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
