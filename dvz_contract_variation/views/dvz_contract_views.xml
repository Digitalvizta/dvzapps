<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dvz_contract_view_form_variation" model="ir.ui.view">
        <field name="name">dvz.contract.form.variation</field>
        <field name="model">dvz.contract</field>
        <field name="inherit_id" ref="dvz_contract.dvz_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_handover']" position="before">
                <button name="action_new_variation" string="New Variation" type="object" invisible="state not in ('progress', 'handover')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_variations" type="object" class="oe_stat_button" icon="fa-exchange" invisible="not variation_count">
                    <field name="variation_count" widget="statinfo" string="Variations"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='totals']/field[@name='amount_untaxed']" position="before">
                <field name="original_amount" invisible="not variation_amount"/>
                <field name="variation_amount" invisible="not variation_amount"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='display_type']" position="after">
                <field name="is_variation" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list" position="attributes">
                <attribute name="decoration-info">is_variation</attribute>
            </xpath>
            <xpath expr="//field[@name='date_end']" position="after">
                <field name="extension_days" invisible="not extension_days"/>
            </xpath>
        </field>
    </record>
</odoo>
