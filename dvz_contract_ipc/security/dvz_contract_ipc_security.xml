<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dvz_contract_ipc_company_rule" model="ir.rule">
        <field name="name">Payment certificates: multi-company</field>
        <field name="model_id" ref="model_dvz_contract_ipc"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="dvz_contract_ipc_line_company_rule" model="ir.rule">
        <field name="name">Payment certificate lines: multi-company</field>
        <field name="model_id" ref="model_dvz_contract_ipc_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
